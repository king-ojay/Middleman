PORT=4000
# Signs session tokens (any long random string). Required when NODE_ENV=production.
SESSION_SECRET=
SESSION_TTL_HOURS=12
MONGO_URI=mongodb://localhost:27017/middleman
# Browser origins allowed to call the API, comma-separated. Required in production;
# localhost:5173/4173 are always allowed outside production.
CORS_ORIGINS=
PAYPACK_CLIENT_ID=
PAYPACK_CLIENT_SECRET=

# One-time codes for signup and PIN reset: console (dev, prints codes to the log) | twilio | africastalking
OTP_PROVIDER=console
OTP_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
