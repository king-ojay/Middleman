PORT=4000
# Signs session tokens (any long random string). Required when NODE_ENV=production.
SESSION_SECRET=
SESSION_TTL_HOURS=12
MONGO_URI=mongodb://localhost:27017/middleman
# Browser origins allowed to call the API, comma-separated. Required in production;
# localhost:5173/4173 are always allowed outside production.
CORS_ORIGINS=

# Escrow payments, SANDBOX only (no real money, ever): fake (moves nothing) | momo-sandbox
PAYMENT_PROVIDER=fake
# momo-sandbox: keys from momodeveloper.mtn.com; scripts/momoSandboxSetup.js creates the user ids and API keys.
MOMO_COLLECTION_SUBSCRIPTION_KEY=
MOMO_COLLECTION_USER_ID=
MOMO_COLLECTION_API_KEY=
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MOMO_DISBURSEMENT_USER_ID=
MOMO_DISBURSEMENT_API_KEY=
# Optional: sandbox currency (EUR), sandbox test number used as every payer/payee, callback URL.
MOMO_CURRENCY=EUR
MOMO_SANDBOX_MSISDN=46733123450
MOMO_CALLBACK_URL=
# Shared secret for the dispute admin routes (X-Admin-Secret header); admin routes are off when empty.
ADMIN_SECRET=

# One-time codes for signup and PIN reset: console (dev, prints codes to the log) | twilio | africastalking
OTP_PROVIDER=console
OTP_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
